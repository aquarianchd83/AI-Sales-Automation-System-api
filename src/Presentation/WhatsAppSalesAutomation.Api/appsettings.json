{
  "ConnectionStrings": {
    "DefaultConnection": "Server=DESKTOP-D22HHMP;Database=WhatsAppSalesAutomation;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Jwt": {
    "Secret": "REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARACTERS",
    "Issuer": "WhatsAppSalesAutomation",
    "Audience": "WhatsAppSalesAutomationClients",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Seed": {
    "SuperAdminEmail": "",
    "SuperAdminPassword": ""
  },
  // Daily database size check: emails the platform operators when usage reaches ThresholdPercent of capacity.
  // CapacityMb 0 = detect (Azure SQL max size, else the data files' max size); set it when the DB has no hard limit.
  "DatabaseSizeMonitor": {
    "Enabled": true,
    "ThresholdPercent": 80,
    "CapacityMb": 0,
    // true = when the alert level is reached, also delete expendable data (see Retention) older than CleanupRetentionDays.
    "AutoCleanup": false,
    "CleanupRetentionDays": 30
  },
  // First-run /setup page. Empty = the page is switched off. Set it by environment variable (Setup__BootstrapKey) only
  // while you create the first platform super admin, then remove it.
  "Setup": {
    "BootstrapKey": ""
  },
  "Cors": {
    "AllowedOrigins": [
      "https://*.saleautomation.com"
    ]
  },
  // Support-agent retrieval thresholds (K.7). MinTopRerankScore below 0.50 or MinSupportingChunks
  // below 1 is REFUSED at retrieval time - they are safety floors, not tuning knobs.
  "SupportRag": {
    "VectorTopN": 50,
    "KeywordTopN": 50,
    "FusionTopN": 30,
    "RerankTopN": 8,
    "MinTopRerankScore": 0.62,
    "MinSupportingRerankScore": 0.50,
    "MinSupportingChunks": 2
  },
  // Cross-encoder reranker. Leave ApiKey empty to run without one: retrieval then uses a stricter
  // evidence gate and the agent escalates more rather than guessing more. Supply it by environment
  // variable (Reranker__Cohere__ApiKey), never in this file.
  "Reranker": {
    "Cohere": { "ApiKey": "", "Model": "rerank-v3.5", "TimeoutSeconds": 3 }
  },
  // The customer-facing WhatsApp consent page the SMS links to. PublicBaseUrl is where the web app is served (no trailing path); the link
  // is {PublicBaseUrl}/consent/{token}. Leave it empty and discovery that ends in a consent SMS is held back rather than charged.
  "ConsentPage": {
    "PublicBaseUrl": "",
    "TokenLifetimeDays": 14,
    "MaxWhatsAppAttempts": 3
  },
  // Fixed-window request budgets. See RateLimitOptions for why auth/webhook/api are bucketed
  // separately and why this is not editable from the Settings screen.
  "RateLimiting": {
    "Enabled": true,
    "Auth": { "PermitLimit": 10, "WindowSeconds": 60 },
    "Webhook": { "PermitLimit": 600, "WindowSeconds": 60 },
    "Api": { "PermitLimit": 300, "WindowSeconds": 60 },
    "ConsentPage": { "PermitLimit": 30, "WindowSeconds": 60 },
    "ExemptIpAddresses": []
  },
  // Response security headers. EnableHsts stays false here and is turned on by the deployed
  // environment's own appsettings - see SecurityHeaderOptions.EnableHsts for why sending it from a
  // dev box is a nuisance to undo.
  "SecurityHeaders": {
    "Enabled": true,
    "EnableHsts": false,
    "HstsMaxAgeDays": 180,
    "HstsIncludeSubDomains": true,
    "HstsPreload": false
  },
  "MediaStorage": {
    "RootPath": "App_Data/media",
    "PublicBasePath": "/media",
    "PublicBaseUrl": "https://trilokieye.nayancare.com/assets/images/eye",
    "Provider": "Local"
    // AWS / S3 settings (bucket, region, access keys, key prefix, CDN address) are deliberately NOT here: the
    // platform administrator manages them on the Platform Admin Console's AWS Settings page and they live
    // only in the AppSettings table (the keys encrypted at rest).
  },
  "LogViewer": {
    "Directory": "logs",
    "FilePrefix": "log-",
    "EnableModuleLogging": true
  },
  "Media": {
    "MaxSizeBytes": 16777216,
    "AllowedContentTypes": [ "image/jpeg", "image/png", "image/webp", "video/mp4", "video/3gpp" ]
  },
  "Campaigns": {
    "MinStepMedia":0,
    "MaxStepMedia": 5
  },
  "Messaging": {
    "MaxSendsPerRun": 20,
    "MaxRetryAttempts": 5,
    "RetryBackoffMinutes": [ 1, 5, 15, 60, 240 ],
    "CustomerServiceWindowHours": 24,
    "DailyTemplateCap": 200,
    "MaxMarketingPerContactPerWindow": 2,
    "MarketingWindowDays": 7,
    "CapStepUpAfterGreenDays": 7,
    "CapStepUps": [ 500, 1000 ]
  },
  "Sms": {
    "ReceiptSecret": ""
  },
  "Ai": {
    "ConfidenceThreshold": 0.6,
    "EscalationIntents": [ "Complaint", "HumanRequest", "Negotiation", "Support" ],
    "KnowledgeBaseTopN": 5,
    "MinRelevanceScore": 0.3,
    "ConversationHistoryTurns": 10,
    "MinFieldExtractionConfidence": 0.6,
    "MaxFieldsToAsk": 3,
    "HandoffOnHotLead": true
  },
  "LeadDiscovery": {
    "MaxRounds": 3,
    "MaxCandidatesPerRound": 20,
    "MaxKnownBusinessesInPrompt": 200,
    "Pricing": {
      "WebSearchPerThousand": 10.0,
      "Models": {
        "claude-haiku-4-5-20251001": { "InputPerMillion": 1.0, "OutputPerMillion": 5.0, "CacheReadPerMillion": 0.1, "CacheWritePerMillion": 1.25 },
        "claude-sonnet-5": { "InputPerMillion": 2.0, "OutputPerMillion": 10.0, "CacheReadPerMillion": 0.2, "CacheWritePerMillion": 2.5 },
        "claude-opus-5": { "InputPerMillion": 5.0, "OutputPerMillion": 25.0, "CacheReadPerMillion": 0.5, "CacheWritePerMillion": 6.25 }
      }
    },
    "Agent": {
      "Provider": "Simulated", //Simulated, Anthropic
      "ApiKey": "",
      "BaseUrl": "https://api.anthropic.com/v1/",
      "ApiVersion": "2023-06-01",
      "Model": "claude-haiku-4-5-20251001",
      "MaxTokens": 16000,
      "Effort": "",
      "MaxSearchesPerRound": 15,
      "MaxFetchesPerRound": 25,
      "MaxFetchContentTokens": 10000,
      "MaxTurns": 6,
      // Set the real key with the LeadDiscovery__Agent__ApiKey environment variable or user secrets - this file is in source control.
      "RequestTimeoutMinutes": 10
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] [{Namespace}::{Method}] [t:{TenantId}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] [{Namespace}::{Method}] [t:{TenantId}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
