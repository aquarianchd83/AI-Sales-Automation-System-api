{
  "ConnectionStrings": {
    "DefaultConnection":  "Server=DESKTOP-D22HHMP;Database=WhatsAppSalesAutomation;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Jwt": {
    "Secret": "REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARACTERS",
    "Issuer": "WhatsAppSalesAutomation",
    "Audience": "WhatsAppSalesAutomationClients",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Seed": {
    "SuperAdminEmail": "",
    "SuperAdminPassword": ""
  },
  "Cors": {
    "AllowedOrigins": [
      "https://*.saleautomation.com"
    ]
  },
  // Fixed-window request budgets. See RateLimitOptions for why auth/webhook/api are bucketed
  // separately and why this is not editable from the Settings screen.
  // Support-agent retrieval thresholds (K.7). MinTopRerankScore below 0.50 or MinSupportingChunks
  // below 1 is REFUSED at retrieval time - they are safety floors, not tuning knobs.
  "SupportRag": {
    "VectorTopN": 50,
    "KeywordTopN": 50,
    "FusionTopN": 30,
    "RerankTopN": 8,
    "MinTopRerankScore": 0.62,
    "MinSupportingRerankScore": 0.50,
    "MinSupportingChunks": 2
  },
  // Cross-encoder reranker. Leave ApiKey empty to run without one: retrieval then uses a stricter
  // evidence gate and the agent escalates more rather than guessing more. Supply it by environment
  // variable (Reranker__Cohere__ApiKey), never in this file.
  "Reranker": {
    "Cohere": { "ApiKey": "", "Model": "rerank-v3.5", "TimeoutSeconds": 3 }
  },
  "RateLimiting": {
    "Enabled": true,
    "Auth": { "PermitLimit": 10, "WindowSeconds": 60 },
    "Webhook": { "PermitLimit": 600, "WindowSeconds": 60 },
    "Api": { "PermitLimit": 300, "WindowSeconds": 60 },
    "ExemptIpAddresses": []
  },
  // Response security headers. EnableHsts stays false here and is turned on by the deployed
  // environment's own appsettings - see SecurityHeaderOptions.EnableHsts for why sending it from a
  // dev box is a nuisance to undo.
  "SecurityHeaders": {
    "Enabled": true,
    "EnableHsts": false,
    "HstsMaxAgeDays": 180,
    "HstsIncludeSubDomains": true,
    "HstsPreload": false
  },
