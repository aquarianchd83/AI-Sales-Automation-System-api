{
  "ConnectionStrings": {
    "DefaultConnection":  "Server=DESKTOP-D22HHMP;Database=WhatsAppSalesAutomation;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Jwt": {
    "Secret": "REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARACTERS",
    "Issuer": "WhatsAppSalesAutomation",
    "Audience": "WhatsAppSalesAutomationClients",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Seed": {
    "SuperAdminEmail": "",
    "SuperAdminPassword": ""
  },
  "WhatsApp": {
    "Provider": "Simulated",
    "PhoneNumberId": "",
    "AccessToken": "",
    "ApiVersion": "v19.0",
    "SimulatedFailureRatePercent": 0
  },
  "MediaStorage": {
    "RootPath": "App_Data/media",
    "PublicBasePath": "/media",
    "PublicBaseUrl": ""
  },
  "Media": {
    "MaxSizeBytes": 16777216,
    "AllowedContentTypes": [ "image/jpeg", "image/png", "image/webp", "video/mp4", "video/3gpp" ]
  },
  "Campaigns": {
    "MinStepMedia": 2,
    "MaxStepMedia": 5
  },
  "Messaging": {
    "MaxSendsPerRun": 20,
    "MaxRetryAttempts": 5,
    "RetryBackoffMinutes": [ 1, 5, 15, 60, 240 ]
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
