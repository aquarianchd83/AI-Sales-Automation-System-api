{
  "Seed": {
    "SuperAdminEmail": "admin@example.com",
    "SuperAdminPassword": "ChangeMe123!",
    "DummyData": true,
    "DummyUserPassword": "DevPass123!"
  },
  "WhatsApp": {
    // Dev-only values so the webhook signature check and GET verification handshake are testable
    // locally without a real Meta App - never real secrets, safe to commit.
    "AppSecret": "dev-app-secret-not-for-production",
    "WebhookVerifyToken": "dev-verify-token"
  },
  "Campaigns": {
    // The base appsettings.json's MinStepMedia:2 matches the Phase 1 design spec and stays
    // as the real default; this dev-only override drops it to 0 so a campaign step can be
    // built and a campaign started locally without first sourcing 2-5 real video/image
    // assets. CampaignOptions' own doc comment invites exactly this override.
    "MinStepMedia": 0
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information"
    }
  }
}
