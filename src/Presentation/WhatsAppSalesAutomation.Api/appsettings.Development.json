{
  "Seed": {
    "SuperAdminEmail": "platformadmin@example.com",
    "SuperAdminPassword": "asd@123A",
    "DummyData": true,
    "DummyUserPassword": "DevPass123!"
  },
  "App": {
    "PublicUrl": "http://localhost:4200"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200",
      "https://localhost:4200",
      "http://*.localhost:4200",
      "https://*.localhost:4200"
    ]
  },
  // Consent links point at the local web app, and the simulated SMS provider keeps what it "sends" for the Demo SMS Outbox page.
  "ConsentPage": {
    "PublicBaseUrl": "http://localhost:4200",
    "DemoOutboxEnabled": true
  },
  "Campaigns": {
    // The base appsettings.json's MinStepMedia:2 matches the Phase 1 design spec and stays
    // as the real default; this dev-only override drops it to 0 so a campaign step can be
    // built and a campaign started locally without first sourcing 2-5 real video/image
    // assets. CampaignOptions' own doc comment invites exactly this override.
    "MinStepMedia": 0
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information"
    }
  }
}
