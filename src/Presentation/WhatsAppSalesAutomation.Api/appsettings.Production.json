// Production overrides. Loaded automatically on top of appsettings.json when ASPNETCORE_ENVIRONMENT=Production.
//
// THIS FILE IS IN GIT - keep every secret EMPTY here. Supply the real values on the server in one of two ways:
//   1. Environment variables, "__" as the section separator (Jwt__Secret, Razorpay__Live__KeySecret, ...), or
//   2. appsettings.Production.local.json next to this file (gitignored; same shape as this file, only the keys you fill in).
// Order of precedence (last wins): appsettings.json < this file < environment variables < appsettings.Production.local.json < AppSettings table.
//
// Keys marked [DB] are AppSettingCatalog keys: on first start AppSettingsSeeder copies the value it finds here (or in the
// local file / env var) into the AppSettings table, and from then on the TABLE wins - change them on the Platform Admin
// Console, not here. An empty value here is seeded as "not set".
{
  // Required. The API refuses to start without a real connection string.
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  // Required. 32+ random characters (openssl rand -base64 48). Empty = the API refuses to start outside Development.
  "Jwt": {
    "Secret": ""
  },
  "Seed": {
    "DummyData": false,
    // Fill both only for the first start to create the platform super admin, then clear them.
    "SuperAdminEmail": "",
    "SuperAdminPassword": ""
  },
  // First-run /setup page stays OFF in production. Set Setup__BootstrapKey only while creating the first super admin.
  "Setup": {
    "BootstrapKey": ""
  },
  // [DB] Public address of the web app (links in emails).
  "App": {
    "PublicUrl": "https://sellio.nayancare.com"
  },
  // Arrays merge by index with appsettings.json, so the full list is repeated here.
  "Cors": {
    "AllowedOrigins": [
      "https://sellio.nayancare.com",
      "https://*.saleautomation.com"
    ]
  },
  "ConsentPage": {
    "PublicBaseUrl": "https://sellio.nayancare.com",
    "DemoOutboxEnabled": false
  },
  "Swagger": {
    "Enabled": false
  },
  "SecurityHeaders": {
    "EnableHsts": true
  },
  // [DB] Razorpay. Production takes real payments, so Live is the active set. Test keys may stay empty.
  "Razorpay": {
    "ActiveMode": "live",
    "Live": {
      "KeyId": "",
      "KeySecret": "",
      "WebhookSecret": ""
    },
    "Test": {
      "KeyId": "",
      "KeySecret": "",
      "WebhookSecret": ""
    }
  },
  // [DB] GST on every new payment (plans, AutoPay, credit packs, wallet recharges).
  "Tax": {
    "Enabled": true
  },
  // [DB] Meta WhatsApp Cloud API (tenant-side defaults / Embedded Signup app).
  "WhatsApp": {
    "Provider": "Meta",
    "AppId": "",
    "AppSecret": "",
    "WebhookVerifyToken": "",
    "EmbeddedSignupConfigId": "",
    "PhoneNumberId": "",
    "WhatsAppBusinessAccountId": "",
    "AccessToken": ""
  },
  // [DB] The platform's own WhatsApp number (tenant notices).
  "PlatformWhatsApp": {
    "PhoneNumberId": "",
    "WhatsAppBusinessAccountId": "",
    "AccessToken": ""
  },
  // [DB] AI provider keys.
  "AiProviders": {
    "OpenAI": { "ApiKey": "" },
    "Anthropic": { "ApiKey": "" },
    "Google": { "ApiKey": "" }
  },
  // [DB] Outgoing email. Empty Host = the platform sends no email.
  "Email": {
    "Smtp": {
      "Host": "",
      "Port": 587,
      "User": "",
      "Password": "",
      "From": "",
      "EnableSsl": true
    }
  },
  // [DB] Msg91 OTP SMS.
  "Sms": {
    "ReceiptSecret": "",
    "Msg91": {
      "AuthKey": "",
      "OtpTemplateId": ""
    }
  }
}
