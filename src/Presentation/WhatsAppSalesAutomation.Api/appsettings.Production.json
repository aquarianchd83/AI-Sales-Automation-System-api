// Production overrides. Loaded automatically on top of appsettings.json when ASPNETCORE_ENVIRONMENT=Production.
//
// THIS FILE IS IN GIT - keep every secret EMPTY here. Supply the real values on the server in one of two ways:
//   1. Environment variables, "__" as the section separator (Jwt__Secret, ConnectionStrings__DefaultConnection, ...), or
//   2. appsettings.Production.local.json next to this file (gitignored; same shape as this file, only the keys you fill in).
// Order of precedence (last wins): appsettings.json < this file < environment variables < appsettings.Production.local.json < AppSettings table.
//
// Only settings that are NOT in the AppSettings table live here. Razorpay, Tax, WhatsApp, AI providers, Email, Sms and
// App:PublicUrl are AppSettingCatalog keys: the DB row wins, so set them on the Platform Admin Console, not in this file.
{
  // Required. The API refuses to start without a real connection string.
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  // Required. 32+ random characters (openssl rand -base64 48). Empty = the API refuses to start outside Development.
  "Jwt": {
    "Secret": ""
  },
  "Seed": {
    "DummyData": false,
    // Fill both only for the first start to create the platform super admin, then clear them.
    "SuperAdminEmail": "",
    "SuperAdminPassword": ""
  },
  // First-run /setup page stays OFF in production. Set Setup__BootstrapKey only while creating the first super admin.
  "Setup": {
    "BootstrapKey": ""
  },
  // Arrays merge by index with appsettings.json, so the full list is repeated here.
  "Cors": {
    "AllowedOrigins": [
      "https://sellio.nayancare.com",
      "https://*.saleautomation.com"
    ]
  },
  "ConsentPage": {
    "PublicBaseUrl": "https://sellio.nayancare.com",
    "DemoOutboxEnabled": false
  },
  "Swagger": {
    "Enabled": false
  },
  "SecurityHeaders": {
    "EnableHsts": true
  }
}
